{
  "multipart": [
    {
      "apply": {
        "model": "minetorio:block/pipe_core"
      }
    },
    {
      "when": {
        "north": "pipe"
      },
      "apply": {
        "model": "minetorio:block/pipe_side"
      }
    },
    {
      "when": {
        "north": "cap"
      },
      "apply": {
        "model": "minetorio:block/pipe_cap"
      }
    },
    {
      "when": {
        "east": "pipe"
      },
      "apply": {
        "model": "minetorio:block/pipe_side",
        "y": 90
      }
    },
    {
      "when": {
        "east": "cap"
      },
      "apply": {
        "model": "minetorio:block/pipe_cap",
        "y": 90
      }
    },
    {
      "when": {
        "south": "pipe"
      },
      "apply": {
        "model": "minetorio:block/pipe_side",
        "y": 180
      }
    },
    {
      "when": {
        "south": "cap"
      },
      "apply": {
        "model": "minetorio:block/pipe_cap",
        "y": 180
      }
    },
    {
      "when": {
        "west": "pipe"
      },
      "apply": {
        "model": "minetorio:block/pipe_side",
        "y": 270
      }
    },
    {
      "when": {
        "west": "cap"
      },
      "apply": {
        "model": "minetorio:block/pipe_cap",
        "y": 270
      }
    },
    {
      "when": {
        "up": "pipe"
      },
      "apply": {
        "model": "minetorio:block/pipe_up"
      }
    },
    {
      "when": {
        "down": "pipe"
      },
      "apply": {
        "model": "minetorio:block/pipe_down"
      }
    },
    {
      "when": {
        "up": "cap"
      },
      "apply": {
        "model": "minetorio:block/pipe_cap",
        "x": 270
      }
    },
    {
      "when": {
        "down": "cap"
      },
      "apply": {
        "model": "minetorio:block/pipe_cap",
        "x": 90
      }
    }
  ]
}
